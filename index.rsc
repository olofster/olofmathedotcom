1:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Person\",\"@id\":\"https://olofmathe.com/#olof\",\"name\":\"Olof Mathé\",\"url\":\"https://olofmathe.com\",\"jobTitle\":[\"Entrepreneur\",\"Product leader\",\"Artist\",\"Writer\"],\"sameAs\":[\"https://www.linkedin.com/in/olofmathe\",\"https://twitter.com/olofster\",\"https://github.com/olofster\"],\"knowsAbout\":[\"Product development\",\"Entrepreneurship\",\"Communication software\",\"Digital art\",\"Art Hack Day\",\"Mathematics education\"]},{\"@type\":\"WebSite\",\"@id\":\"https://olofmathe.com/#site\",\"url\":\"https://olofmathe.com\",\"name\":\"Olof Mathé\",\"about\":{\"@id\":\"https://olofmathe.com/#olof\"}}]}"}}],[[["$","link","css:/assets/index-D5-3QYdu.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-D5-3QYdu.css","data-rsc-css-href":"/assets/index-D5-3QYdu.css"}],"$undefined"],["$","main",null,{"className":"prose-sketch prose-r prose-p","children":[["$","$L6",null,{}],[["$","h1",null,{"children":"Olof Mathé"}],["$","section",null,{"id":"work","children":[["$","h2",null,{"children":"Work"}],["$","p",null,{"children":["I founded and built ",["$","a",null,{"href":"https://www.mixmax.com/","children":"Mixmax"}],", where I was CEO. Before that, I built products at ",["$","a",null,{"href":"https://www.linkedin.com/company/inklingsf/","children":"Inkling"}]," and ",["$","a",null,{"href":"https://www.linkedin.com/company/skype/","children":"Skype / Microsoft"}]," and cut my teeth with Fortune 500s at ",["$","a",null,{"href":"https://www.mckinsey.com/","children":"McKinsey"}],". My earliest ventures were a local classifieds site and a voice-based shopping app."," I studied engineering physics at KTH and École polytechnique, and philosophy of science at École normale supérieure."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Initiatives"}],["$","p",null,{"children":["I founded ",["$","a",null,{"href":"https://arthackday.net/","children":"Art Hack Day"}],", a computer-art event exploring the expressive potential of new technology, held in cities like New York, San Francisco, Paris, and Berlin. I also co-organize the San Francisco chapter of ",["$","a",null,{"href":"https://www.theglobalmathcircle.org/","children":"Global Math Circle"}],"."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Art"}],["$","p",null,{"children":["I make ",["$","$L7",null,{"href":"/art/","children":"public installations, performances, and software experiments"}]," - from transforming facades to choreographing drones and auctioning artists’ Facebook profiles."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Writing"}],["$","p",null,{"children":["I contributed a ",["$","a",null,{"href":"https://www.taylorfrancis.com/chapters/edit/10.4324/9781351241212-15/art-hack-day-olof-math%C3%A9","children":"chapter"}]," to a Routledge book on computer art. I’ve also written ",["$","$L7",null,{"href":"/writing","children":"essays"}]," for Svenska Dagbladet and a Centre Pompidou exhibition catalogue."]}]]}]],["$","section",null,{"children":[["$","h2",null,{"children":"Other projects"}],["$","p",null,{"children":["Fashion, surreal food, and ",["$","$L7",null,{"href":"/other-projects/","children":"more"}],"."]}]]}],["$","p",null,{"className":"prose-contact","children":["You can contact me on ",["$","a",null,{"href":"https://x.com/Olofster","children":"X"}]," or ",["$","a",null,{"href":"https://www.linkedin.com/in/olofmathe","children":"LinkedIn"}],"."]}]]}]]]
